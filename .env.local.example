# Kopiera den här filen till .env.local och fyll i din nyckel
# Lägg ALDRIG .env.local i Git

ANTHROPIC_API_KEY=din-anthropic-nyckel-här

# ─── Analytics (PostHog) ─────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST: från ditt PostHog-
# projekt (EU Cloud, se slutrapporten). Dessa värden är INTE hemliga –
# PostHog-projekt-tokens är avsedda att vara publika (de kan bara skicka
# in events, inte läsa data) – men ligger ändå i .env.local som allt annat
# miljöberoende.
#
# NEXT_PUBLIC_ENABLE_ANALYTICS: styr om statistik över huvud taget kan vara
# aktiv i en miljö. Exakt strängen "true" slår på den; allt annat (tom, osatt,
# "1" ...) betyder av. Typisk uppsättning: lämna den tom lokalt; sätt den till
# "true" i Vercel Production och i den skyddade Preview-miljö som används för
# interna tester. Miljön avgör själv – dokumentationen utgår inte från att
# Preview är av eller på.
#
# Även med flaggan satt till "true" laddas och startas PostHog först när
# besökaren aktivt har valt "Tillåt produktstatistik" (src/utils/
# analyticsConsent.js). Är flaggan inte "true" visas varken valet eller
# länken "Ändra val för statistik", och PostHog används aldrig.
#
# Observera: en miljö där flaggan är på skickar händelser till det PostHog-
# projekt som NEXT_PUBLIC_POSTHOG_KEY pekar på – efter ett ja. Använder en
# Preview samma nyckel som Production hamnar interna tester i samma
# statistik. Använd ett separat projekt/nyckel för Preview om testdata inte
# ska blandas med riktig statistik.
NEXT_PUBLIC_POSTHOG_KEY=din-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_ENABLE_ANALYTICS=
